---
# Checks kept deliberately narrow: each one here has found a real defect in
# this codebase, or guards a mistake the Qt 5 -> Qt 6 port is prone to.
# Adding a whole category (modernize-*, readability-*) buries those in
# thousands of style hits and the output stops being read.
Checks: >
  -*,
  bugprone-branch-clone,
  bugprone-copy-constructor-init,
  bugprone-dangling-handle,
  bugprone-macro-parentheses,
  bugprone-parent-virtual-call,
  bugprone-suspicious-memset-usage,
  bugprone-use-after-move,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.NewDelete,
  clang-analyzer-cplusplus.NewDeleteLeaks,
  clang-analyzer-unix.Malloc,
  cppcoreguidelines-slicing,
  misc-redundant-expression,
  modernize-use-nullptr,
  modernize-use-override,
  performance-for-range-copy,
  performance-implicit-conversion-in-loop,
  performance-unnecessary-value-param

# tools/SingleApplication is vendored upstream code. It is updated by
# replacing the directory, not by patching it, so findings there are noise.
HeaderFilterRegex: '^(?!.*SingleApplication).*\.h$'

WarningsAsErrors: ''
FormatStyle: none
